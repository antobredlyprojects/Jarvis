# ─────────────────────────────────────────────────
#   J.A.R.V.I.S. Mainframe — Environment Config
# ─────────────────────────────────────────────────

# Get your FREE Groq key at: https://console.groq.com
# No credit card required. Very generous free limits.
GROQ_API_KEY=your_groq_api_key_here

# Model — llama-3.3-70b-versatile is free and very powerful
GROQ_MODEL=openai/gpt-oss-120b

# Server port (default: 3000)
PORT=3000

# ── Kokoro TTS (local, free) ──────────────────────────
# Voice: bm_george (British male), bm_daniel, bm_lewis, bf_alice, bf_emma
KOKORO_VOICE=bm_george
# Language: b = British English, a = American English
KOKORO_LANG=b
# Speech speed: 1.0 = normal, 0.85 = slower, 1.15 = faster
KOKORO_RATE=1.0
